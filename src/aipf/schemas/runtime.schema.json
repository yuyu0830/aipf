{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "project_id", "goal", "state", "created_at", "updated_at", "active_plan_id", "active_session_id"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "format": "uuid"},
    "goal": {"type": "string", "minLength": 1},
    "state": {"enum": ["awaiting_plan", "awaiting_plan_confirmation", "ready", "ready_to_dispatch", "running", "awaiting_task_confirmation", "blocked", "completed", "cancelled"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "active_plan_id": {"type": ["string", "null"], "pattern": "^P_[0-9]{4,}$"},
    "active_session_id": {"type": ["string", "null"], "pattern": "^S_[A-Za-z0-9_-]+$"}
  }
}
