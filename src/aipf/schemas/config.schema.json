{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "context", "execution", "review", "routing", "security"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "context": {"type": "object", "required": ["rollover_threshold"], "properties": {"rollover_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}},
    "execution": {
      "type": "object", "required": ["max_concurrency", "max_retries", "heartbeat_interval_seconds", "heartbeat_timeout_seconds"],
      "properties": {
        "max_concurrency": {"type": "integer", "minimum": 1}, "max_retries": {"type": "integer", "minimum": 0},
        "heartbeat_interval_seconds": {"type": "integer", "minimum": 1}, "heartbeat_timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "review": {
      "type": "object", "required": ["medium_uses_court", "court"],
      "properties": {
        "medium_uses_court": {"type": "boolean"},
        "court": {
          "type": "object", "required": ["critics", "defenders", "judges", "max_rounds"],
          "properties": {"critics": {"const": 2}, "defenders": {"const": 2}, "judges": {"const": 1}, "max_rounds": {"type": "integer", "minimum": 1}}
        }
      }
    },
    "routing": {
      "type": "object", "required": ["weights", "models"],
      "properties": {
        "weights": {
          "type": "object", "required": ["quality", "cost", "security", "context", "tools"],
          "properties": {
            "quality": {"type": "number", "minimum": 0}, "cost": {"type": "number", "minimum": 0},
            "security": {"type": "number", "minimum": 0}, "context": {"type": "number", "minimum": 0},
            "tools": {"type": "number", "minimum": 0}
          }
        },
        "models": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["provider", "model", "quality", "cost", "security", "context", "tools", "local", "context_tokens", "enabled"],
            "properties": {
              "provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1},
              "quality": {"type": "number", "minimum": 0, "maximum": 1}, "cost": {"type": "number", "minimum": 0, "maximum": 1},
              "security": {"type": "number", "minimum": 0, "maximum": 1}, "context": {"type": "number", "minimum": 0, "maximum": 1},
              "tools": {"type": "number", "minimum": 0, "maximum": 1}, "local": {"type": "boolean"},
              "context_tokens": {"type": "integer", "minimum": 0}, "enabled": {"type": "boolean"}
            }
          }
        }
      }
    },
    "security": {
      "type": "object", "required": ["workspace_only", "require_network_approval", "require_delete_approval", "require_external_transfer_approval", "allowed_commands"],
      "properties": {
        "workspace_only": {"type": "boolean"}, "require_network_approval": {"type": "boolean"},
        "require_delete_approval": {"type": "boolean"}, "require_external_transfer_approval": {"type": "boolean"},
        "allowed_commands": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
